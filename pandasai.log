# Looking at the table description: order_id (string), order_date (datetime), aging (integer), ship_mode (string), product_category (string), product (string), ...
# The prompt says: "Quais s�o as 10 categorias mais frequentes da primeira coluna categ�rica? Mostre a contagem e o percentual em uma tabela."
# The first categorical column in the table is `ship_mode`.

query = """
WITH total AS (
    SELECT COUNT(*) AS total_count 
    FROM me07_me07_88431051ff8e
)
SELECT 
    ship_mode AS categoria,
    COUNT(*) AS contagem,
    ROUND(COUNT(*) * 100.0 / (SELECT total_count FROM total), 2) AS percentual
FROM me07_me07_88431051ff8e
GROUP BY ship_mode
ORDER BY contagem DESC
LIMIT 10;
"""

